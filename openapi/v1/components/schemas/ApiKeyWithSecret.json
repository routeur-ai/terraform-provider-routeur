{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ApiKeyWithSecret",
  "description": "An API key as returned by create and rotate: the only responses that ever carry the plaintext `key`. Store it; it cannot be read again.",
  "type": "object",
  "required": [
    "id",
    "project_id",
    "name",
    "fingerprint",
    "state",
    "enabled",
    "last_used_at",
    "revoked_at",
    "disabled_at",
    "created_at",
    "updated_at",
    "key"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^key_[1-9][0-9]*$",
      "description": "Public id of the API key.",
      "examples": [
        "key_12"
      ]
    },
    "project_id": {
      "type": "string",
      "pattern": "^proj_[1-9][0-9]*$",
      "description": "Public id of the project.",
      "examples": [
        "proj_12"
      ]
    },
    "name": {
      "type": "string"
    },
    "fingerprint": {
      "type": "string",
      "description": "Display form of the key, e.g. sk-r-…abcd."
    },
    "state": {
      "type": "string",
      "enum": [
        "active",
        "disabled",
        "revoked"
      ],
      "description": "New states may be added; treat unknown as not active."
    },
    "enabled": {
      "type": "boolean",
      "description": "false when the key is disabled or revoked; true only for state active. Writable via PATCH (revoked keys cannot be re-enabled)."
    },
    "last_used_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "ISO-8601, UTC; null when not set."
    },
    "revoked_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "ISO-8601, UTC; null when not set."
    },
    "disabled_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "ISO-8601, UTC; null when not set."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601, UTC."
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601, UTC."
    },
    "key": {
      "type": "string",
      "pattern": "^sk-r-",
      "description": "The secret, shown once."
    }
  }
}
