{
  "Organisation": {
    "name": "organisation",
    "in": "path",
    "required": true,
    "description": "Organisation slug (GET /me → organisation.slug).",
    "schema": {
      "type": "string"
    }
  },
  "Workspace": {
    "name": "workspace",
    "in": "path",
    "required": true,
    "description": "The workspace’s slug, or its id (`ws_12`) as returned in `workspace_id`. Either form addresses the same workspace; one in another organisation is a 404.",
    "schema": {
      "type": "string"
    }
  },
  "ProjectId": {
    "name": "projectId",
    "in": "path",
    "required": true,
    "schema": {
      "type": "string",
      "pattern": "^proj_[1-9][0-9]*$"
    }
  },
  "KeyId": {
    "name": "keyId",
    "in": "path",
    "required": true,
    "schema": {
      "type": "string",
      "pattern": "^key_[1-9][0-9]*$"
    }
  },
  "RuleId": {
    "name": "ruleId",
    "in": "path",
    "required": true,
    "schema": {
      "type": "string",
      "pattern": "^route_[1-9][0-9]*$"
    }
  },
  "BudgetId": {
    "name": "budgetId",
    "in": "path",
    "required": true,
    "schema": {
      "type": "string",
      "pattern": "^bud_[1-9][0-9]*$"
    }
  },
  "CredentialId": {
    "name": "credentialId",
    "in": "path",
    "required": true,
    "schema": {
      "type": "string",
      "pattern": "^cred_[1-9][0-9]*$"
    }
  },
  "Limit": {
    "name": "limit",
    "in": "query",
    "required": false,
    "description": "Page size, 1–200 (default 100). Out of range is a 422.",
    "schema": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200,
      "default": 100
    }
  },
  "Cursor": {
    "name": "cursor",
    "in": "query",
    "required": false,
    "description": "meta.next_cursor (or prev_cursor) of the previous page. An undecodable cursor is a 422.",
    "schema": {
      "type": "string"
    }
  },
  "PolicyId": {
    "name": "policyId",
    "in": "path",
    "required": true,
    "schema": {
      "type": "string",
      "pattern": "^dlp_[1-9][0-9]*$"
    }
  },
  "ModerationRuleId": {
    "name": "ruleId",
    "in": "path",
    "required": true,
    "schema": {
      "type": "string",
      "pattern": "^mod_[1-9][0-9]*$"
    }
  },
  "ShieldRuleId": {
    "name": "ruleId",
    "in": "path",
    "required": true,
    "schema": {
      "type": "string",
      "pattern": "^shield_[1-9][0-9]*$"
    }
  },
  "ModelSlug": {
    "name": "model",
    "in": "path",
    "required": true,
    "description": "Model slug `<provider>:<model_id>`, e.g. `openai:gpt-4o` or `google:gemini-2.5-pro` (Gemini ids are stored without the upstream `models/` prefix). Send it as is: a `/` inside a model id is part of the value, not a path separator.",
    "schema": {
      "type": "string"
    }
  }
}
