{
  "collection": {
    "parameters": [
      {
        "$ref": "../components/parameters.json#/Organisation"
      },
      {
        "$ref": "../components/parameters.json#/Workspace"
      }
    ],
    "get": {
      "operationId": "listClassifierRules",
      "tags": [
        "Classifier rules"
      ],
      "summary": "List classifier rules",
      "description": "Not plan-gated (plan feature `toxicity-scoring` gates create and update only), so reads and deletes keep working after a downgrade. Permission: `moderation.view`. Reuses the moderation permission set.",
      "parameters": [
        {
          "$ref": "../components/parameters.json#/Limit"
        },
        {
          "$ref": "../components/parameters.json#/Cursor"
        }
      ],
      "responses": {
        "200": {
          "description": "A page of classifier rules, oldest first.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "data",
                  "links",
                  "meta"
                ],
                "properties": {
                  "data": {
                    "type": "array",
                    "items": {
                      "$ref": "../components/schemas/ClassifierRule.json"
                    }
                  },
                  "links": {
                    "$ref": "../components/schemas/PaginationLinks.json"
                  },
                  "meta": {
                    "$ref": "../components/schemas/PaginationMeta.json"
                  }
                }
              }
            }
          }
        },
        "401": {
          "$ref": "../components/responses.json#/Unauthenticated"
        },
        "403": {
          "$ref": "../components/responses.json#/Forbidden"
        },
        "404": {
          "$ref": "../components/responses.json#/NotFound"
        },
        "422": {
          "description": "validation_failed — limit or cursor out of range.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../components/schemas/Error.json"
              }
            }
          }
        },
        "429": {
          "$ref": "../components/responses.json#/RateLimited"
        },
        "500": {
          "$ref": "../components/responses.json#/ServerError"
        }
      }
    },
    "post": {
      "operationId": "createClassifierRule",
      "tags": [
        "Classifier rules"
      ],
      "summary": "Create a classifier rule",
      "description": "Plan feature: `toxicity-scoring` (403 `feature_unavailable` otherwise). Permission: `moderation.create`.",
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../components/schemas/ClassifierRuleInput.json"
            }
          }
        }
      },
      "responses": {
        "201": {
          "description": "Created.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "data"
                ],
                "properties": {
                  "data": {
                    "$ref": "../components/schemas/ClassifierRule.json"
                  }
                }
              }
            }
          },
          "headers": {
            "Location": {
              "description": "URL of the created resource.",
              "schema": {
                "type": "string",
                "format": "uri"
              }
            }
          }
        },
        "401": {
          "$ref": "../components/responses.json#/Unauthenticated"
        },
        "403": {
          "$ref": "../components/responses.json#/Forbidden"
        },
        "404": {
          "$ref": "../components/responses.json#/NotFound"
        },
        "422": {
          "$ref": "../components/responses.json#/ValidationFailed"
        },
        "429": {
          "$ref": "../components/responses.json#/RateLimited"
        },
        "500": {
          "$ref": "../components/responses.json#/ServerError"
        }
      }
    }
  },
  "item": {
    "parameters": [
      {
        "$ref": "../components/parameters.json#/Organisation"
      },
      {
        "$ref": "../components/parameters.json#/Workspace"
      },
      {
        "name": "classifierRuleId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^clf_[1-9][0-9]*$"
        }
      }
    ],
    "get": {
      "operationId": "getClassifierRule",
      "tags": [
        "Classifier rules"
      ],
      "summary": "Get a classifier rule",
      "description": "Not plan-gated (plan feature `toxicity-scoring` gates create and update only), so reads and deletes keep working after a downgrade. Permission: `moderation.view`.",
      "responses": {
        "200": {
          "description": "The a classifier rule.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "data"
                ],
                "properties": {
                  "data": {
                    "$ref": "../components/schemas/ClassifierRule.json"
                  }
                }
              }
            }
          }
        },
        "401": {
          "$ref": "../components/responses.json#/Unauthenticated"
        },
        "403": {
          "$ref": "../components/responses.json#/Forbidden"
        },
        "404": {
          "$ref": "../components/responses.json#/NotFound"
        },
        "429": {
          "$ref": "../components/responses.json#/RateLimited"
        },
        "500": {
          "$ref": "../components/responses.json#/ServerError"
        }
      }
    },
    "put": {
      "operationId": "replaceClassifierRule",
      "tags": [
        "Classifier rules"
      ],
      "summary": "Replace a classifier rule",
      "description": "Plan feature: `toxicity-scoring` (403 `feature_unavailable` otherwise). Permission: `moderation.update`. Full replace; PUTting back what GET returned changes nothing (nothing is recorded or propagated). `enabled` is set here.",
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../components/schemas/ClassifierRuleInput.json"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "The a classifier rule as stored.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "data"
                ],
                "properties": {
                  "data": {
                    "$ref": "../components/schemas/ClassifierRule.json"
                  }
                }
              }
            }
          }
        },
        "401": {
          "$ref": "../components/responses.json#/Unauthenticated"
        },
        "403": {
          "$ref": "../components/responses.json#/Forbidden"
        },
        "404": {
          "$ref": "../components/responses.json#/NotFound"
        },
        "422": {
          "$ref": "../components/responses.json#/ValidationFailed"
        },
        "429": {
          "$ref": "../components/responses.json#/RateLimited"
        },
        "500": {
          "$ref": "../components/responses.json#/ServerError"
        }
      }
    },
    "delete": {
      "operationId": "deleteClassifierRule",
      "tags": [
        "Classifier rules"
      ],
      "summary": "Delete a classifier rule",
      "description": "Not plan-gated (plan feature `toxicity-scoring` gates create and update only), so reads and deletes keep working after a downgrade. Permission: `moderation.delete`.",
      "responses": {
        "204": {
          "$ref": "../components/responses.json#/NoContent"
        },
        "401": {
          "$ref": "../components/responses.json#/Unauthenticated"
        },
        "403": {
          "$ref": "../components/responses.json#/Forbidden"
        },
        "404": {
          "$ref": "../components/responses.json#/NotFound"
        },
        "429": {
          "$ref": "../components/responses.json#/RateLimited"
        },
        "500": {
          "$ref": "../components/responses.json#/ServerError"
        }
      }
    }
  }
}
