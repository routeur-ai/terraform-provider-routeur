{
  "collection": {
    "parameters": [
      {
        "$ref": "../components/parameters.json#/Organisation"
      },
      {
        "$ref": "../components/parameters.json#/Workspace"
      }
    ],
    "get": {
      "operationId": "listRoutingRules",
      "tags": [
        "Routing rules"
      ],
      "summary": "List routing rules",
      "description": "Permission: `routing.rules.view`.",
      "parameters": [
        {
          "$ref": "../components/parameters.json#/Limit"
        },
        {
          "$ref": "../components/parameters.json#/Cursor"
        }
      ],
      "responses": {
        "200": {
          "description": "A page of rules in evaluation order (priority ascending, the Default route last).",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "data",
                  "links",
                  "meta"
                ],
                "properties": {
                  "data": {
                    "type": "array",
                    "items": {
                      "$ref": "../components/schemas/RoutingRule.json"
                    }
                  },
                  "links": {
                    "$ref": "../components/schemas/PaginationLinks.json"
                  },
                  "meta": {
                    "$ref": "../components/schemas/PaginationMeta.json"
                  }
                }
              }
            }
          }
        },
        "401": {
          "$ref": "../components/responses.json#/Unauthenticated"
        },
        "403": {
          "$ref": "../components/responses.json#/Forbidden"
        },
        "404": {
          "$ref": "../components/responses.json#/NotFound"
        },
        "422": {
          "description": "validation_failed — limit or cursor out of range.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../components/schemas/Error.json"
              }
            }
          }
        },
        "429": {
          "$ref": "../components/responses.json#/RateLimited"
        },
        "500": {
          "$ref": "../components/responses.json#/ServerError"
        }
      }
    },
    "post": {
      "operationId": "createRoutingRule",
      "tags": [
        "Routing rules"
      ],
      "summary": "Create a routing rule",
      "description": "Permission: `routing.rules.create`.",
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../components/schemas/RoutingRuleInput.json"
            }
          }
        }
      },
      "responses": {
        "201": {
          "description": "Created.",
          "headers": {
            "Location": {
              "description": "URL of the created resource.",
              "schema": {
                "type": "string",
                "format": "uri"
              }
            }
          },
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "data"
                ],
                "properties": {
                  "data": {
                    "$ref": "../components/schemas/RoutingRule.json"
                  }
                }
              }
            }
          }
        },
        "401": {
          "$ref": "../components/responses.json#/Unauthenticated"
        },
        "403": {
          "$ref": "../components/responses.json#/Forbidden"
        },
        "404": {
          "$ref": "../components/responses.json#/NotFound"
        },
        "422": {
          "$ref": "../components/responses.json#/ValidationFailed"
        },
        "429": {
          "$ref": "../components/responses.json#/RateLimited"
        },
        "500": {
          "$ref": "../components/responses.json#/ServerError"
        }
      }
    }
  },
  "item": {
    "parameters": [
      {
        "$ref": "../components/parameters.json#/Organisation"
      },
      {
        "$ref": "../components/parameters.json#/Workspace"
      },
      {
        "$ref": "../components/parameters.json#/RuleId"
      }
    ],
    "get": {
      "operationId": "getRoutingRule",
      "tags": [
        "Routing rules"
      ],
      "summary": "Get a routing rule",
      "description": "Permission: `routing.rules.view`.",
      "responses": {
        "200": {
          "description": "The rule.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "data"
                ],
                "properties": {
                  "data": {
                    "$ref": "../components/schemas/RoutingRule.json"
                  }
                }
              }
            }
          }
        },
        "401": {
          "$ref": "../components/responses.json#/Unauthenticated"
        },
        "403": {
          "$ref": "../components/responses.json#/Forbidden"
        },
        "404": {
          "$ref": "../components/responses.json#/NotFound"
        },
        "429": {
          "$ref": "../components/responses.json#/RateLimited"
        },
        "500": {
          "$ref": "../components/responses.json#/ServerError"
        }
      }
    },
    "put": {
      "operationId": "replaceRoutingRule",
      "tags": [
        "Routing rules"
      ],
      "summary": "Replace a routing rule",
      "description": "Permission: `routing.rules.update`.",
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../components/schemas/RoutingRuleInput.json"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "The rule as stored.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "data"
                ],
                "properties": {
                  "data": {
                    "$ref": "../components/schemas/RoutingRule.json"
                  }
                }
              }
            }
          }
        },
        "401": {
          "$ref": "../components/responses.json#/Unauthenticated"
        },
        "403": {
          "$ref": "../components/responses.json#/Forbidden"
        },
        "404": {
          "$ref": "../components/responses.json#/NotFound"
        },
        "422": {
          "description": "validation_failed, or default_route_protected for the Default route (use /default-route).",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../components/schemas/Error.json"
              }
            }
          }
        },
        "429": {
          "$ref": "../components/responses.json#/RateLimited"
        },
        "500": {
          "$ref": "../components/responses.json#/ServerError"
        }
      }
    },
    "delete": {
      "operationId": "deleteRoutingRule",
      "tags": [
        "Routing rules"
      ],
      "summary": "Delete a routing rule",
      "description": "Permission: `routing.rules.delete`.",
      "responses": {
        "204": {
          "$ref": "../components/responses.json#/NoContent"
        },
        "401": {
          "$ref": "../components/responses.json#/Unauthenticated"
        },
        "403": {
          "$ref": "../components/responses.json#/Forbidden"
        },
        "404": {
          "$ref": "../components/responses.json#/NotFound"
        },
        "422": {
          "description": "default_route_protected — the Default route cannot be deleted.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../components/schemas/Error.json"
              }
            }
          }
        },
        "429": {
          "$ref": "../components/responses.json#/RateLimited"
        },
        "500": {
          "$ref": "../components/responses.json#/ServerError"
        }
      }
    }
  },
  "default": {
    "parameters": [
      {
        "$ref": "../components/parameters.json#/Organisation"
      },
      {
        "$ref": "../components/parameters.json#/Workspace"
      }
    ],
    "get": {
      "operationId": "getDefaultRoute",
      "tags": [
        "Routing rules"
      ],
      "summary": "Get the Default route",
      "description": "Permission: `routing.rules.view`.",
      "responses": {
        "200": {
          "description": "The workspace’s Default route (created on first read if missing).",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "data"
                ],
                "properties": {
                  "data": {
                    "$ref": "../components/schemas/RoutingRule.json"
                  }
                }
              }
            }
          }
        },
        "401": {
          "$ref": "../components/responses.json#/Unauthenticated"
        },
        "403": {
          "$ref": "../components/responses.json#/Forbidden"
        },
        "404": {
          "$ref": "../components/responses.json#/NotFound"
        },
        "429": {
          "$ref": "../components/responses.json#/RateLimited"
        },
        "500": {
          "$ref": "../components/responses.json#/ServerError"
        }
      }
    },
    "put": {
      "operationId": "replaceDefaultRoute",
      "tags": [
        "Routing rules"
      ],
      "summary": "Set the Default route’s quality bias",
      "description": "Permission: `routing.rules.update`.",
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../components/schemas/DefaultRouteInput.json"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "The Default route as stored.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "data"
                ],
                "properties": {
                  "data": {
                    "$ref": "../components/schemas/RoutingRule.json"
                  }
                }
              }
            }
          }
        },
        "401": {
          "$ref": "../components/responses.json#/Unauthenticated"
        },
        "403": {
          "$ref": "../components/responses.json#/Forbidden"
        },
        "404": {
          "$ref": "../components/responses.json#/NotFound"
        },
        "422": {
          "$ref": "../components/responses.json#/ValidationFailed"
        },
        "429": {
          "$ref": "../components/responses.json#/RateLimited"
        },
        "500": {
          "$ref": "../components/responses.json#/ServerError"
        }
      }
    }
  }
}
