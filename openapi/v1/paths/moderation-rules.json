        "$ref": "../components/parameters.json#/Organisation"
      }
    ],
    "get": {
      "operationId": "getModerationSettings",
      "tags": [
        "Output moderation"
      ],
      "summary": "Get moderation settings",
      "description": "Permission: `moderation.view`. Not plan-gated (plan feature `output-moderation` gates create and update only), so reads and deletes keep working after a downgrade. Organisation-wide, so it is not under a workspace.",
      "responses": {
        "200": {
          "description": "The settings.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
