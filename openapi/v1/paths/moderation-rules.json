      "tags": [
        "Output moderation"
      ],
      "summary": "Replace moderation settings",
      "description": "Permission: `moderation.update`. Requires the plan feature `output-moderation`. Setting the current value is a no-op.",
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../components/schemas/ModerationSettingsInput.json"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "The settings as stored.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "data"
                ],
                "properties": {
