{
  "collection": {
    "parameters": [
      {
        "$ref": "../components/parameters.json#/Organisation"
      },
      {
        "$ref": "../components/parameters.json#/Workspace"
      }
    ],
    "get": {
      "operationId": "listAnomalyDetectors",
      "tags": [
        "Anomaly detectors"
      ],
      "summary": "List anomaly detectors",
      "description": "Not plan-gated (plan feature `anomaly-detection` gates create and update only), so reads and deletes keep working after a downgrade. Permission: `anomalies.viewer`. Detectors only: anomaly events (acknowledge/resolve) are operational state, not configuration, and are not exposed.",
      "parameters": [
        {
          "$ref": "../components/parameters.json#/Limit"
        },
        {
          "$ref": "../components/parameters.json#/Cursor"
        }
      ],
      "responses": {
        "200": {
          "description": "A page of anomaly detectors, oldest first.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "data",
                  "links",
                  "meta"
                ],
                "properties": {
                  "data": {
                    "type": "array",
                    "items": {
                      "$ref": "../components/schemas/AnomalyDetector.json"
                    }
                  },
                  "links": {
                    "$ref": "../components/schemas/PaginationLinks.json"
                  },
                  "meta": {
                    "$ref": "../components/schemas/PaginationMeta.json"
                  }
                }
              }
            }
          }
        },
        "401": {
          "$ref": "../components/responses.json#/Unauthenticated"
        },
        "403": {
          "$ref": "../components/responses.json#/Forbidden"
        },
        "404": {
          "$ref": "../components/responses.json#/NotFound"
        },
        "422": {
          "description": "validation_failed — limit or cursor out of range.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../components/schemas/Error.json"
              }
            }
          }
        },
        "429": {
          "$ref": "../components/responses.json#/RateLimited"
        },
        "500": {
          "$ref": "../components/responses.json#/ServerError"
        }
      }
    },
    "post": {
      "operationId": "createAnomalyDetector",
      "tags": [
        "Anomaly detectors"
      ],
      "summary": "Create an anomaly detector",
      "description": "Plan feature: `anomaly-detection` (403 `feature_unavailable` otherwise). Permission: `anomalies.admin`.",
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../components/schemas/AnomalyDetectorInput.json"
            }
          }
        }
      },
      "responses": {
        "201": {
          "description": "Created.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "data"
                ],
                "properties": {
                  "data": {
                    "$ref": "../components/schemas/AnomalyDetector.json"
                  }
                }
              }
            }
          },
          "headers": {
            "Location": {
              "description": "URL of the created resource.",
              "schema": {
                "type": "string",
                "format": "uri"
              }
            }
          }
        },
        "401": {
          "$ref": "../components/responses.json#/Unauthenticated"
        },
        "403": {
          "$ref": "../components/responses.json#/Forbidden"
        },
        "404": {
          "$ref": "../components/responses.json#/NotFound"
        },
        "422": {
          "$ref": "../components/responses.json#/ValidationFailed"
        },
        "429": {
          "$ref": "../components/responses.json#/RateLimited"
        },
        "500": {
          "$ref": "../components/responses.json#/ServerError"
        }
      }
    }
  },
  "item": {
    "parameters": [
      {
        "$ref": "../components/parameters.json#/Organisation"
      },
      {
        "$ref": "../components/parameters.json#/Workspace"
      },
      {
        "name": "detectorId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^anom_[1-9][0-9]*$"
        }
      }
    ],
    "get": {
      "operationId": "getAnomalyDetector",
      "tags": [
        "Anomaly detectors"
      ],
      "summary": "Get an anomaly detector",
      "description": "Not plan-gated (plan feature `anomaly-detection` gates create and update only), so reads and deletes keep working after a downgrade. Permission: `anomalies.viewer`.",
      "responses": {
        "200": {
          "description": "The an anomaly detector.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "data"
                ],
                "properties": {
                  "data": {
                    "$ref": "../components/schemas/AnomalyDetector.json"
                  }
                }
              }
            }
          }
        },
        "401": {
          "$ref": "../components/responses.json#/Unauthenticated"
        },
        "403": {
          "$ref": "../components/responses.json#/Forbidden"
        },
        "404": {
          "$ref": "../components/responses.json#/NotFound"
        },
        "429": {
          "$ref": "../components/responses.json#/RateLimited"
        },
        "500": {
          "$ref": "../components/responses.json#/ServerError"
        }
      }
    },
    "put": {
      "operationId": "replaceAnomalyDetector",
      "tags": [
        "Anomaly detectors"
      ],
      "summary": "Replace an anomaly detector",
      "description": "Plan feature: `anomaly-detection` (403 `feature_unavailable` otherwise). Permission: `anomalies.admin`. Full replace; PUTting back what GET returned changes nothing (nothing is recorded or propagated). `enabled` is set here.",
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../components/schemas/AnomalyDetectorInput.json"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "The an anomaly detector as stored.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "data"
                ],
                "properties": {
                  "data": {
                    "$ref": "../components/schemas/AnomalyDetector.json"
                  }
                }
              }
            }
          }
        },
        "401": {
          "$ref": "../components/responses.json#/Unauthenticated"
        },
        "403": {
          "$ref": "../components/responses.json#/Forbidden"
        },
        "404": {
          "$ref": "../components/responses.json#/NotFound"
        },
        "422": {
          "$ref": "../components/responses.json#/ValidationFailed"
        },
        "429": {
          "$ref": "../components/responses.json#/RateLimited"
        },
        "500": {
          "$ref": "../components/responses.json#/ServerError"
        }
      }
    },
    "delete": {
      "operationId": "deleteAnomalyDetector",
      "tags": [
        "Anomaly detectors"
      ],
      "summary": "Delete an anomaly detector",
      "description": "Not plan-gated (plan feature `anomaly-detection` gates create and update only), so reads and deletes keep working after a downgrade. Permission: `anomalies.admin`.",
      "responses": {
        "204": {
          "$ref": "../components/responses.json#/NoContent"
        },
        "401": {
          "$ref": "../components/responses.json#/Unauthenticated"
        },
        "403": {
          "$ref": "../components/responses.json#/Forbidden"
        },
        "404": {
          "$ref": "../components/responses.json#/NotFound"
        },
        "429": {
          "$ref": "../components/responses.json#/RateLimited"
        },
        "500": {
          "$ref": "../components/responses.json#/ServerError"
        }
      }
    }
  }
}
