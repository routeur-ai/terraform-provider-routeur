{
  "collection": {
    "parameters": [
      {
        "$ref": "../components/parameters.json#/Organisation"
      },
      {
        "$ref": "../components/parameters.json#/Workspace"
      }
    ],
    "get": {
      "operationId": "listApiKeys",
      "tags": [
        "API keys"
      ],
      "summary": "List API keys",
      "description": "Permission: `api_keys.view`.",
      "parameters": [
        {
          "$ref": "../components/parameters.json#/Limit"
        },
        {
          "$ref": "../components/parameters.json#/Cursor"
        }
      ],
      "responses": {
        "200": {
          "description": "A page of keys, oldest first.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "data",
                  "links",
                  "meta"
                ],
                "properties": {
                  "data": {
                    "type": "array",
                    "items": {
                      "$ref": "../components/schemas/ApiKey.json"
                    }
                  },
                  "links": {
                    "$ref": "../components/schemas/PaginationLinks.json"
                  },
                  "meta": {
                    "$ref": "../components/schemas/PaginationMeta.json"
                  }
                }
              }
            }
          }
        },
        "401": {
          "$ref": "../components/responses.json#/Unauthenticated"
        },
        "403": {
          "$ref": "../components/responses.json#/Forbidden"
        },
        "404": {
          "$ref": "../components/responses.json#/NotFound"
        },
        "422": {
          "description": "validation_failed — limit or cursor out of range.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../components/schemas/Error.json"
              }
            }
          }
        },
        "429": {
          "$ref": "../components/responses.json#/RateLimited"
        },
        "500": {
          "$ref": "../components/responses.json#/ServerError"
        }
      }
    },
    "post": {
      "operationId": "createApiKey",
      "tags": [
        "API keys"
      ],
      "summary": "Create an API key",
      "description": "Permission: `api_keys.create`.",
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../components/schemas/ApiKeyCreate.json"
            }
          }
        }
      },
      "responses": {
        "201": {
          "description": "Created. The only time this key’s secret is returned.",
          "headers": {
            "Location": {
              "description": "URL of the created resource.",
              "schema": {
                "type": "string",
                "format": "uri"
              }
            }
          },
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "data"
                ],
                "properties": {
                  "data": {
                    "$ref": "../components/schemas/ApiKeyWithSecret.json"
                  }
                }
              }
            }
          }
        },
        "401": {
          "$ref": "../components/responses.json#/Unauthenticated"
        },
        "403": {
          "$ref": "../components/responses.json#/Forbidden"
        },
        "404": {
          "$ref": "../components/responses.json#/NotFound"
        },
        "422": {
          "description": "validation_failed (including a project_id outside this workspace), or workspace_has_no_projects.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../components/schemas/Error.json"
              }
            }
          }
        },
        "429": {
          "$ref": "../components/responses.json#/RateLimited"
        },
        "500": {
          "$ref": "../components/responses.json#/ServerError"
        }
      }
    }
  },
  "item": {
    "parameters": [
      {
        "$ref": "../components/parameters.json#/Organisation"
      },
      {
        "$ref": "../components/parameters.json#/Workspace"
      },
      {
        "$ref": "../components/parameters.json#/KeyId"
      }
    ],
    "get": {
      "operationId": "getApiKey",
      "tags": [
        "API keys"
      ],
      "summary": "Get an API key",
      "description": "Permission: `api_keys.view`.",
      "responses": {
        "200": {
          "description": "The key.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "data"
                ],
                "properties": {
                  "data": {
                    "$ref": "../components/schemas/ApiKey.json"
                  }
                }
              }
            }
          }
        },
        "401": {
          "$ref": "../components/responses.json#/Unauthenticated"
        },
        "403": {
          "$ref": "../components/responses.json#/Forbidden"
        },
        "404": {
          "$ref": "../components/responses.json#/NotFound"
        },
        "429": {
          "$ref": "../components/responses.json#/RateLimited"
        },
        "500": {
          "$ref": "../components/responses.json#/ServerError"
        }
      }
    },
    "patch": {
      "operationId": "updateApiKey",
      "tags": [
        "API keys"
      ],
      "summary": "Rename, move, disable or enable an API key",
      "description": "All requested changes apply together or not at all. A body with nothing to change returns the key unchanged.",
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../components/schemas/ApiKeyUpdate.json"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "The updated key.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "data"
                ],
                "properties": {
                  "data": {
                    "$ref": "../components/schemas/ApiKey.json"
                  }
                }
              }
            }
          }
        },
        "401": {
          "$ref": "../components/responses.json#/Unauthenticated"
        },
        "403": {
          "$ref": "../components/responses.json#/Forbidden"
        },
        "404": {
          "$ref": "../components/responses.json#/NotFound"
        },
        "422": {
          "description": "validation_failed, key_revoked (a revoked key cannot change), or project_not_in_workspace.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../components/schemas/Error.json"
              }
            }
          }
        },
        "429": {
          "$ref": "../components/responses.json#/RateLimited"
        },
        "500": {
          "$ref": "../components/responses.json#/ServerError"
        }
      }
    },
    "delete": {
      "operationId": "deleteApiKey",
      "tags": [
        "API keys"
      ],
      "summary": "Delete an API key",
      "description": "Permission: `api_keys.revoke`. An active or disabled key is revoked and deleted in one step; the audit log records both.",
      "responses": {
        "204": {
          "$ref": "../components/responses.json#/NoContent"
        },
        "401": {
          "$ref": "../components/responses.json#/Unauthenticated"
        },
        "403": {
          "$ref": "../components/responses.json#/Forbidden"
        },
        "404": {
          "$ref": "../components/responses.json#/NotFound"
        },
        "429": {
          "$ref": "../components/responses.json#/RateLimited"
        },
        "500": {
          "$ref": "../components/responses.json#/ServerError"
        }
      }
    }
  },
  "rotate": {
    "parameters": [
      {
        "$ref": "../components/parameters.json#/Organisation"
      },
      {
        "$ref": "../components/parameters.json#/Workspace"
      },
      {
        "$ref": "../components/parameters.json#/KeyId"
      }
    ],
    "post": {
      "operationId": "rotateApiKey",
      "tags": [
        "API keys"
      ],
      "summary": "Rotate an API key",
      "description": "Permission: `api_keys.rotate`. Rotation is replacement: the response is a NEW key with a NEW id (and secret) and the old key is revoked. Model rotation in Terraform as destroy-and-create, not an in-place update.",
      "responses": {
        "201": {
          "description": "The replacement key (new id), with its secret. The old key is revoked.",
          "headers": {
            "Location": {
              "description": "URL of the created resource.",
              "schema": {
                "type": "string",
                "format": "uri"
              }
            }
          },
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "data"
                ],
                "properties": {
                  "data": {
                    "$ref": "../components/schemas/ApiKeyWithSecret.json"
                  }
                }
              }
            }
          }
        },
        "401": {
          "$ref": "../components/responses.json#/Unauthenticated"
        },
        "403": {
          "$ref": "../components/responses.json#/Forbidden"
        },
        "404": {
          "$ref": "../components/responses.json#/NotFound"
        },
        "422": {
          "description": "key_revoked — create a new key instead.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../components/schemas/Error.json"
              }
            }
          }
        },
        "429": {
          "$ref": "../components/responses.json#/RateLimited"
        },
        "500": {
          "$ref": "../components/responses.json#/ServerError"
        }
      }
    }
  },
  "revoke": {
    "parameters": [
      {
        "$ref": "../components/parameters.json#/Organisation"
      },
      {
        "$ref": "../components/parameters.json#/Workspace"
      },
      {
        "$ref": "../components/parameters.json#/KeyId"
      }
    ],
    "post": {
      "operationId": "revokeApiKey",
      "tags": [
        "API keys"
      ],
      "summary": "Revoke an API key",
      "description": "Permission: `api_keys.revoke`.",
      "responses": {
        "200": {
          "description": "The revoked key. Idempotent.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "data"
                ],
                "properties": {
                  "data": {
                    "$ref": "../components/schemas/ApiKey.json"
                  }
                }
              }
            }
          }
        },
        "401": {
          "$ref": "../components/responses.json#/Unauthenticated"
        },
        "403": {
          "$ref": "../components/responses.json#/Forbidden"
        },
        "404": {
          "$ref": "../components/responses.json#/NotFound"
        },
        "429": {
          "$ref": "../components/responses.json#/RateLimited"
        },
        "500": {
          "$ref": "../components/responses.json#/ServerError"
        }
      }
    }
  }
}
