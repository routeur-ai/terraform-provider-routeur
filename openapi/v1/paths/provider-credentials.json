{
  "collection": {
    "parameters": [
      {
        "$ref": "../components/parameters.json#/Organisation"
      }
    ],
    "get": {
      "operationId": "listProviderCredentials",
      "tags": [
        "Provider credentials"
      ],
      "summary": "List provider credentials",
      "description": "Permission: `providers.view`.",
      "parameters": [
        {
          "$ref": "../components/parameters.json#/Limit"
        },
        {
          "$ref": "../components/parameters.json#/Cursor"
        }
      ],
      "responses": {
        "200": {
          "description": "A page of credentials, oldest first.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "data",
                  "links",
                  "meta"
                ],
                "properties": {
                  "data": {
                    "type": "array",
                    "items": {
                      "$ref": "../components/schemas/ProviderCredential.json"
                    }
                  },
                  "links": {
                    "$ref": "../components/schemas/PaginationLinks.json"
                  },
                  "meta": {
                    "$ref": "../components/schemas/PaginationMeta.json"
                  }
                }
              }
            }
          }
        },
        "401": {
          "$ref": "../components/responses.json#/Unauthenticated"
        },
        "403": {
          "$ref": "../components/responses.json#/Forbidden"
        },
        "404": {
          "$ref": "../components/responses.json#/NotFound"
        },
        "422": {
          "description": "validation_failed — limit or cursor out of range.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../components/schemas/Error.json"
              }
            }
          }
        },
        "429": {
          "$ref": "../components/responses.json#/RateLimited"
        },
        "500": {
          "$ref": "../components/responses.json#/ServerError"
        }
      }
    },
    "post": {
      "operationId": "createProviderCredential",
      "tags": [
        "Provider credentials"
      ],
      "summary": "Add a provider credential",
      "description": "Permission: `providers.create`. The key is verified against the provider before anything is stored.",
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../components/schemas/ProviderCredentialCreate.json"
            }
          }
        }
      },
      "responses": {
        "201": {
          "description": "Created. The response never contains the key.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "data"
                ],
                "properties": {
                  "data": {
                    "$ref": "../components/schemas/ProviderCredential.json"
                  }
                }
              }
            }
          },
          "headers": {
            "Location": {
              "description": "URL of the created resource.",
              "schema": {
                "type": "string",
                "format": "uri"
              }
            }
          }
        },
        "401": {
          "$ref": "../components/responses.json#/Unauthenticated"
        },
        "403": {
          "$ref": "../components/responses.json#/Forbidden"
        },
        "404": {
          "$ref": "../components/responses.json#/NotFound"
        },
        "422": {
          "description": "validation_failed — including a key the provider rejects (on `key`), a label already used for this provider (on `label`), and a provider the organisation already has a credential for (on `provider`; the message names that credential’s id, e.g. `cred_3`, so a client can import it — rotate its key instead).",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../components/schemas/Error.json"
              }
            }
          }
        },
        "429": {
          "$ref": "../components/responses.json#/RateLimited"
        },
        "500": {
          "$ref": "../components/responses.json#/ServerError"
        }
      }
    }
  },
  "item": {
    "parameters": [
      {
        "$ref": "../components/parameters.json#/Organisation"
      },
      {
        "$ref": "../components/parameters.json#/CredentialId"
      }
    ],
    "get": {
      "operationId": "getProviderCredential",
      "tags": [
        "Provider credentials"
      ],
      "summary": "Get a provider credential",
      "description": "Permission: `providers.view`.",
      "responses": {
        "200": {
          "description": "The credential.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "data"
                ],
                "properties": {
                  "data": {
                    "$ref": "../components/schemas/ProviderCredential.json"
                  }
                }
              }
            }
          }
        },
        "401": {
          "$ref": "../components/responses.json#/Unauthenticated"
        },
        "403": {
          "$ref": "../components/responses.json#/Forbidden"
        },
        "404": {
          "$ref": "../components/responses.json#/NotFound"
        },
        "429": {
          "$ref": "../components/responses.json#/RateLimited"
        },
        "500": {
          "$ref": "../components/responses.json#/ServerError"
        }
      }
    },
    "patch": {
      "operationId": "updateProviderCredential",
      "tags": [
        "Provider credentials"
      ],
      "summary": "Relabel, enable, disable or rotate a provider credential",
      "description": "Permission: `providers.update`; sending `key` at all also needs `providers.create` (403 otherwise, whether or not it matches the stored key, so the response never reveals the key). All requested changes apply together or not at all. A request that changes nothing (including resending the stored key) writes nothing.",
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../components/schemas/ProviderCredentialUpdate.json"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "The credential.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "data"
                ],
                "properties": {
                  "data": {
                    "$ref": "../components/schemas/ProviderCredential.json"
                  }
                }
              }
            }
          }
        },
        "401": {
          "$ref": "../components/responses.json#/Unauthenticated"
        },
        "403": {
          "$ref": "../components/responses.json#/Forbidden"
        },
        "404": {
          "$ref": "../components/responses.json#/NotFound"
        },
        "422": {
          "description": "validation_failed — including a key the provider rejects (on `key`) and a label already used for this provider (on `label`).",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../components/schemas/Error.json"
              }
            }
          }
        },
        "429": {
          "$ref": "../components/responses.json#/RateLimited"
        },
        "500": {
          "$ref": "../components/responses.json#/ServerError"
        }
      }
    },
    "delete": {
      "operationId": "deleteProviderCredential",
      "tags": [
        "Provider credentials"
      ],
      "summary": "Delete a provider credential",
      "description": "Permission: `providers.delete`. The gateway stops using the key once the change propagates; if another enabled credential for the same provider remains, the gateway falls back to it.",
      "responses": {
        "204": {
          "$ref": "../components/responses.json#/NoContent"
        },
        "401": {
          "$ref": "../components/responses.json#/Unauthenticated"
        },
        "403": {
          "$ref": "../components/responses.json#/Forbidden"
        },
        "404": {
          "$ref": "../components/responses.json#/NotFound"
        },
        "429": {
          "$ref": "../components/responses.json#/RateLimited"
        },
        "500": {
          "$ref": "../components/responses.json#/ServerError"
        }
      }
    }
  }
}
